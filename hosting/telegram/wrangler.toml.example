# Copy to wrangler.toml and replace the KV namespace ID before deployment.
name = "alphedge-research-bot"
main = "worker.mjs"
compatibility_date = "2026-09-01"

[[kv_namespaces]]
binding = "SUBSCRIBERS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[triggers]
crons = ["17 * * * *"] # Check once per hour; send only for a new month or trend-state change.
