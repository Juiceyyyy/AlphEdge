# Free public site: fetch the public snapshot. GitHub Actions sets RESEARCH_SNAPSHOT_FILE separately.
RESEARCH_SNAPSHOT_URL=https://raw.githubusercontent.com/Juiceyyyy/AlphEdge/main/state/current_snapshot.json
RESEARCH_SCENARIOS_URL=https://raw.githubusercontent.com/Juiceyyyy/AlphEdge/main/state/scenarios.json
# Optional local database storage when RESEARCH_SNAPSHOT_FILE is unset.
DATABASE_URL=
# Local runner only; never set these on the public site or cron job.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
TRADING_ENABLED=false
BROKER_IP_CONFIRMED=false
# Local quarterly review after earnings releases (Mar, Jun, Sep, Dec).
REBALANCE_MONTHS=3,6,9,12
EARNINGS_GATE=required
# public = completed close from free source; broker requires paid market-data tier.
BROKER_QUOTE_SOURCE=public
MAX_CAPITAL_INR=0
MAX_ORDER_NOTIONAL_INR=0
