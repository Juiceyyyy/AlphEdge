# Free public site: fetch the public snapshot. GitHub Actions sets RESEARCH_SNAPSHOT_FILE separately.
RESEARCH_SNAPSHOT_URL=https://raw.githubusercontent.com/Juiceyyyy/AlphEdge/main/state/current_snapshot.json
# Optional local database storage when RESEARCH_SNAPSHOT_FILE is unset.
DATABASE_URL=
# Local runner only; never set these on the public site or cron job.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
TRADING_ENABLED=false
MAX_CAPITAL_INR=0
MAX_ORDER_NOTIONAL_INR=0
